# Copy to .env and replace every change_me value. .env is gitignored; never commit it.

# PostgreSQL 16 (docker compose). The password is applied only when the volume is first created.
POSTGRES_USER=estimation
POSTGRES_PASSWORD=change_me
POSTGRES_DB=estimation_ai
POSTGRES_PORT=5432
# Used by the API, the migration script and the worker. Must match the values above.
DATABASE_URL=postgresql://estimation:change_me@localhost:5432/estimation_ai

# Redis 7 (docker compose; Node-side use later). Host port 6380 avoids a local Redis on 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# API
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Worker
WORKER_POLL_INTERVAL_SECONDS=2

# Uploads (git-ignored). Relative paths resolve against the repository root. Shared by API and worker.
UPLOAD_DIR=uploads
# Upload size limit in bytes (default 524288000 = 500 MB)
MAX_UPLOAD_BYTES=524288000

# Text reader (Phase 4b). A glyph set (one CAD font) is identified by a font id.
GLYPH_FONT_ID=default
# Optional local OCR cross-check. Off by default. Needs `make setup-ocr`. Never needed for decoding.
OCR_CROSSCHECK_ENABLED=false


# Tests run against a SEPARATE database (default: the name of DATABASE_URL's database + "_test",
# created and migrated by `make test-db`). Set TEST_DATABASE_URL only to use another server; its
# database name must end with "_test". Tests refuse to run against any other name.
# TEST_DATABASE_URL=postgresql://estimation:change_me@localhost:5432/estimation_ai_test
