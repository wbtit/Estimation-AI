#!/usr/bin/env bash
# Blocks commits that contain secrets. Enable once per clone with: make hooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; commit blocked." >&2
  echo "Install it with ./scripts/install-gitleaks.sh (see docs/SECURITY.md)." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
