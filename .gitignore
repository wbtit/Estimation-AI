# Secrets: only .env.example (placeholders) is committed
.env
.env.*
!.env.example

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Client data: drawings and uploads are never committed
uploads/
fixtures/private/
fixtures/**/*.pdf
fixtures/**/*.PDF

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# local notes, not in git: Claude/context notes and all docs stay on this machine only
# (README.md files stay tracked)
CLAUDE.md
.claude/
docs/
*.md
!README.md
