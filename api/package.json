{
  "name": "@estimation-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0 && tsc --noEmit",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx src/scripts/generate-schema.ts",
    "catalog:import": "tsx src/scripts/import-catalog.ts",
    "kinds:load-abbreviations": "tsx src/scripts/load-kind-abbreviations.ts",
    "seed:synthetic": "tsx src/scripts/seed-synthetic.ts",
    "test-db": "tsx src/scripts/ensure-test-db.ts",
    "prefixes:load": "tsx src/scripts/load-prefix-meanings.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
